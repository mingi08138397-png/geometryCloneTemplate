<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Geometry Dash Clone</title>
  <style>
:root {
  --bg: #080b16;
  --panel: rgba(10, 15, 30, 0.88);
  --panel-strong: rgba(15, 22, 44, 0.95);
  --line: #9ef0ff;
  --accent: #53d1ff;
  --accent-2: #ffda67;
  --danger: #ff6b8a;
  --success: #89ff90;
  --text: #eff8ff;
  --shadow: #10233f;
}

* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html,
body {
  margin: 0;
  min-height: 100%;
  background: radial-gradient(circle at top, #1b2042, var(--bg) 60%);
  color: var(--text);
  font-family: "Courier New", Courier, monospace;
  overflow: hidden;
}

body {
  touch-action: none;
}

#app {
  position: relative;
  width: 100vw;
  height: 100vh;
}

#game-canvas {
  width: 100%;
  height: 100%;
  display: block;
  image-rendering: pixelated;
}

#hud {
  position: absolute;
  inset: 0 auto auto 0;
  width: min(100%, 1000px);
  padding: 14px 16px 0;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  pointer-events: none;
}

#hud.hidden {
  display: none;
}

.hud-topline {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
  font-size: clamp(0.78rem, 2vw, 1rem);
  letter-spacing: 0.14em;
  text-shadow: 2px 2px 0 var(--shadow);
}

.progress-shell {
  position: relative;
  height: 24px;
  border: 3px solid var(--line);
  background: rgba(6, 11, 22, 0.9);
  box-shadow: 0 0 0 3px rgba(17, 37, 70, 0.85);
  overflow: hidden;
}

#progress-fill {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, #57ffa5, #53d1ff 70%, #fef27a);
  image-rendering: pixelated;
}

#progress-label {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-shadow: 2px 2px 0 #00121e;
}

#screen-root {
  position: absolute;
  inset: 0;
  z-index: 20;
  pointer-events: none;
  display: grid;
  place-items: center;
  padding: 18px;
}

.screen {
  pointer-events: auto;
  width: min(92vw, 680px);
  border: 4px solid var(--line);
  background: linear-gradient(180deg, rgba(14, 21, 44, 0.92), rgba(7, 11, 24, 0.94));
  box-shadow: 0 0 0 6px rgba(11, 25, 44, 0.85), 0 22px 48px rgba(0, 0, 0, 0.4);
  padding: clamp(18px, 4vw, 34px);
  text-align: center;
}

.screen h1,
.screen h2 {
  margin: 0 0 14px;
  letter-spacing: 0.12em;
  text-shadow: 3px 3px 0 #172b55;
}

.screen h1 {
  font-size: clamp(1.8rem, 5vw, 3rem);
}

.screen h2 {
  font-size: clamp(1.4rem, 4vw, 2.2rem);
}

.screen p {
  margin: 10px auto;
  max-width: 44ch;
  line-height: 1.5;
}

.button-row,
.card-row {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 18px;
}

.pixel-button,
.character-card {
  border: 3px solid var(--line);
  background: linear-gradient(180deg, rgba(27, 55, 99, 0.95), rgba(16, 32, 62, 0.95));
  color: var(--text);
  box-shadow: 0 0 0 3px #10233f;
}

.pixel-button {
  cursor: pointer;
  font: inherit;
  font-weight: 700;
  letter-spacing: 0.12em;
  padding: 12px 18px;
  min-width: 148px;
}

.pixel-button:hover,
.pixel-button:focus-visible,
.character-card:hover,
.character-card:focus-visible {
  outline: none;
  transform: translateY(-2px);
  border-color: var(--accent-2);
}

.pixel-button.alt {
  background: linear-gradient(180deg, rgba(90, 46, 105, 0.95), rgba(47, 26, 62, 0.95));
}

.pixel-button.danger {
  background: linear-gradient(180deg, rgba(126, 43, 76, 0.95), rgba(72, 22, 41, 0.95));
}

.character-card {
  width: min(100%, 250px);
  padding: 14px;
  cursor: pointer;
}

.character-card.selected {
  border-color: var(--accent-2);
  box-shadow: 0 0 0 3px #6f5600;
}

.character-card canvas {
  width: 100%;
  max-width: 180px;
  aspect-ratio: 1;
  margin: 6px auto 10px;
  display: block;
  image-rendering: pixelated;
  background: radial-gradient(circle at top, #29345e, #0c1120 70%);
  border: 3px solid rgba(255, 255, 255, 0.08);
}

.mini-stats {
  display: grid;
  gap: 8px;
  margin-top: 18px;
  font-size: 0.95rem;
}

.tip {
  color: #b5d8ff;
  font-size: 0.92rem;
}

.flashy {
  color: var(--accent-2);
}

#game-controls { position:absolute; top:74px; right:max(14px, calc((100vw - 1000px)/2)); z-index:30; display:none; gap:8px; }
#game-controls.visible { display:flex; }
#game-controls button { border:2px solid var(--line); color:var(--text); background:rgba(8,15,32,.88); padding:9px 12px; font:700 13px "Courier New",monospace; cursor:pointer; box-shadow:0 0 0 2px #10233f; }
#game-controls button:hover { border-color:var(--accent-2); }
#world-switch-button { display:none; border-color:#68f7ff !important; color:#68f7ff !important; }
#world-switch-button.enabled { display:inline-block; }
#world-switch-button.phase-b { border-color:#ff7ee7 !important; color:#ff7ee7 !important; }
.stage-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; margin-top:18px; }
.stage-card { min-width:0; border:2px solid var(--line); background:rgba(20,35,65,.95); color:var(--text); padding:14px 10px; font:inherit; cursor:pointer; text-align:left; }
.stage-card strong { display:block; color:var(--accent-2); margin-bottom:6px; }
.stage-card span { font-size:.82rem; line-height:1.4; }
.stage-card.selected { border-color:var(--accent-2); background:rgba(65,70,105,.95); }
.setting-row { display:flex; justify-content:space-between; align-items:center; gap:12px; margin:12px auto; max-width:420px; text-align:left; }
.setting-row button { border:2px solid var(--line); background:#142644; color:var(--text); padding:8px 12px; font:inherit; cursor:pointer; }
@media (max-width: 640px) { #game-controls { top:76px; right:10px; } #game-controls button { padding:8px; font-size:11px; } .stage-grid { grid-template-columns:1fr; max-height:42vh; overflow:auto; } }

@media (max-width: 640px) {
  .screen {
    padding: 18px 14px 22px;
  }

  .pixel-button {
    min-width: 128px;
    width: 100%;
  }

  .character-card {
    width: 100%;
  }
}

  </style>
</head>
<body>
  <div id="app">
    <canvas id="game-canvas" aria-label="Geometry Dash Clone game canvas"></canvas>

    <header id="hud" class="hidden" aria-live="polite">
      <div class="hud-topline">
        <span id="stage-indicator">STAGE 1</span>
        <span id="character-indicator">CUBE</span>
      </div>
      <div class="progress-shell">
        <div id="progress-fill"></div>
        <span id="progress-label">0%</span>
      </div>
    </header>

    <div id="game-controls"><button id="world-switch-button" type="button">⇄ 세계 전환 [X]</button><button id="pause-button" type="button">Ⅱ 설정 / 일시정지</button></div>
    <div id="screen-root"></div>
  </div>

  <script>
/* =========================================================
   mapGen.js  –  맵 생성 알고리즘
   ========================================================= */
const TILE = 40;
const STAGE_LENGTH = 8000;
const WORLD_HEIGHT = 540;
const GROUND_Y = 430;

const CUBE_PATTERNS = [
  'singleSpike',
  'doubleSpike',
  'tripleSpike',
  'shortBlock',
  'blockSpike',
  'tallBlockPad',
  'boostLane',
  'slowLane',
  'doubleBlock',
];

const SHIP_PAD_TYPES = ['boost', 'slow'];

const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

function hashString(value) {
  let hash = 2166136261;
  for (let i = 0; i < value.length; i += 1) {
    hash ^= value.charCodeAt(i);
    hash = Math.imul(hash, 16777619);
  }
  return hash >>> 0;
}

class SeededRandom {
  constructor(seed) {
    this.seed = seed >>> 0;
  }

  next() {
    this.seed = (1664525 * this.seed + 1013904223) >>> 0;
    return this.seed / 4294967296;
  }

  float(min = 0, max = 1) {
    return min + (max - min) * this.next();
  }

  int(min, max) {
    return Math.floor(this.float(min, max + 1));
  }

  chance(probability) {
    return this.next() < probability;
  }

  pick(items) {
    return items[this.int(0, items.length - 1)];
  }
}

function buildStageTheme(stageNumber, character) {
  const themes = [
    {
      skyTop: '#1d2047',
      skyBottom: '#090c1c',
      glow: '#53d1ff',
      glow2: '#f3ff72',
      ground: '#183352',
      ground2: '#0e213a',
    },
    {
      skyTop: '#26144c',
      skyBottom: '#090616',
      glow: '#ff78cb',
      glow2: '#53d1ff',
      ground: '#3a2059',
      ground2: '#1d1236',
    },
    {
      skyTop: '#0f314d',
      skyBottom: '#051017',
      glow: '#53ffbf',
      glow2: '#8dd6ff',
      ground: '#15575c',
      ground2: '#0a2f34',
    },
    {
      skyTop: '#3c1b2d',
      skyBottom: '#0e0813',
      glow: '#ffb347',
      glow2: '#ff6b8a',
      ground: '#55322d',
      ground2: '#2b1716',
    },
  ];

  const theme = { ...themes[(stageNumber - 1) % themes.length] };
  if (character === 'ship') {
    theme.glow2 = '#f8fbff';
  }
  return theme;
}

function createStars(rng, length, theme) {
  const stars = [];
  const layerSpeeds = [0.18, 0.35, 0.55];
  const counts = [64, 48, 36];

  counts.forEach((count, layerIndex) => {
    for (let i = 0; i < count; i += 1) {
      const size = 2 + layerIndex;
      stars.push({
        x: rng.float(0, length),
        y: rng.float(24, WORLD_HEIGHT - 120),
        size,
        layer: layerIndex,
        speedFactor: layerSpeeds[layerIndex],
        color: layerIndex === 0 ? theme.glow2 : layerIndex === 1 ? theme.glow : '#ffffff',
      });
    }
  });

  return stars;
}

function obstacleRect(type, x, y, w, h, extra = {}) {
  return { type, x, y, w, h, ...extra };
}

function padRect(type, x, y, w, h, extra = {}) {
  return { id: `${type}-${Math.round(x)}-${Math.round(y)}`, type, x, y, w, h, ...extra };
}

function buildTerrain(stageNumber, character) {
  if (character !== 'cube' || stageNumber === 1) return [{ x: 0, y: GROUND_Y }, { x: STAGE_LENGTH, y: GROUND_Y }];
  // Geometry-Dash-style elevation changes: long ramps, raised lanes, and drops.
  const profiles = {
    2: [[0,430],[900,430],[1120,385],[1640,385],[1840,430],[2750,430],[2960,365],[3450,365],[3650,430],[4700,430],[4900,390],[5350,390],[5540,430],[8000,430]],
    3: [[0,430],[760,430],[960,370],[1450,370],[1630,430],[2250,430],[2460,350],[2940,350],[3150,430],[4050,430],[4270,380],[4660,380],[4860,430],[5650,430],[5860,360],[6350,360],[6550,430],[8000,430]],
    4: [[0,430],[700,430],[900,385],[1300,385],[1500,430],[2050,430],[2260,345],[2670,345],[2880,430],[3500,430],[3720,375],[4100,375],[4300,430],[4950,430],[5170,355],[5600,355],[5810,430],[6500,430],[6700,390],[7100,390],[7300,430],[8000,430]],
  };
  return profiles[stageNumber].map(([x,y])=>({x,y}));
}

function terrainYAt(terrain, worldX) {
  if (!terrain || terrain.length < 2) return GROUND_Y;
  const x = clamp(worldX, terrain[0].x, terrain[terrain.length - 1].x);
  for (let i = 1; i < terrain.length; i += 1) {
    const a = terrain[i - 1], b = terrain[i];
    if (x <= b.x) {
      const t = (x - a.x) / Math.max(1, b.x - a.x);
      return a.y + (b.y - a.y) * t;
    }
  }
  return terrain[terrain.length - 1].y;
}

function generateCubeMap(rng, stageNumber) {
  const obstacles = [];
  const pads = [];
  const difficulty = stageNumber - 1;
  let x = 430;
  let segmentIndex = 0;

  while (x < STAGE_LENGTH - 650) {
    const safeGap = rng.int(155, 245) + difficulty * 8;
    x += safeGap;
    const maxPattern = stageNumber === 1 ? 2 : stageNumber === 2 ? 4 : stageNumber === 3 ? 5 : 6;
    const pattern = CUBE_PATTERNS[rng.int(0, maxPattern)];

    if (pattern === 'singleSpike') {
      obstacles.push(obstacleRect('spikeUp', x, GROUND_Y - 30, 28, 30));
      x += 95;
    } else if (pattern === 'doubleSpike') {
      obstacles.push(obstacleRect('spikeUp', x, GROUND_Y - 30, 28, 30));
      obstacles.push(obstacleRect('spikeUp', x + 26, GROUND_Y - 30, 28, 30));
      x += 130;
    } else if (pattern === 'tripleSpike') {
      for (let i = 0; i < 3; i += 1) {
        obstacles.push(obstacleRect('spikeUp', x + i * 26, GROUND_Y - 30, 28, 30));
      }
      x += 165;
    } else if (pattern === 'shortBlock') {
      obstacles.push(obstacleRect('block', x, GROUND_Y - 44, 44, 44));
      x += 125;
    } else if (pattern === 'blockSpike') {
      obstacles.push(obstacleRect('block', x, GROUND_Y - 44, 44, 44));
      obstacles.push(obstacleRect('spikeUp', x + 56, GROUND_Y - 30, 28, 30));
      x += 165;
    } else if (pattern === 'tallBlockPad') {
      pads.push(padRect('jump', x - 82, GROUND_Y - 18, 42, 18, { power: 760 }));
      obstacles.push(obstacleRect('block', x, GROUND_Y - 86, 48, 86));
      x += 165;
    } else if (pattern === 'boostLane') {
      pads.push(padRect('boost', x - 14, GROUND_Y - 16, 48, 16, { multiplier: 1.38, duration: 2.3 }));
      obstacles.push(obstacleRect('spikeUp', x + 110, GROUND_Y - 30, 28, 30));
      obstacles.push(obstacleRect('spikeUp', x + 136, GROUND_Y - 30, 28, 30));
      x += 220;
    } else if (pattern === 'slowLane') {
      pads.push(padRect('slow', x - 10, GROUND_Y - 16, 48, 16, { multiplier: 0.78, duration: 2.7 }));
      obstacles.push(obstacleRect('block', x + 102, GROUND_Y - 44, 44, 44));
      obstacles.push(obstacleRect('spikeUp', x + 158, GROUND_Y - 30, 28, 30));
      x += 240;
    } else if (pattern === 'doubleBlock') {
      obstacles.push(obstacleRect('block', x, GROUND_Y - 44, 42, 44));
      obstacles.push(obstacleRect('block', x + 92, GROUND_Y - 44, 42, 44));
      x += 190;
    }

    if (segmentIndex % 7 === 5 && stageNumber >= 3 && rng.chance(0.16)) {
      pads.push(padRect('jump', x + 28, GROUND_Y - 18, 42, 18, { power: 740 }));
      obstacles.push(obstacleRect('block', x + 120, GROUND_Y - 70, 44, 70));
      x += 210;
    }

    segmentIndex += 1;
  }

  // Jump orbs: optional mid-air boosts, placed at readable, predictable intervals.
  // They reward a well-timed extra tap instead of making the course harder by surprise.
  if (stageNumber >= 2) {
    for (let orbX = 1850; orbX < STAGE_LENGTH - 500; orbX += 2350) {
      pads.push(padRect('orb', orbX, GROUND_Y - (stageNumber >= 3 ? 154 : 132), 34, 34, { power: 700 }));
    }
  }

  return {
    type: 'cube',
    groundY: GROUND_Y,
    obstacles,
    pads,
    length: STAGE_LENGTH,
    baseSpeed: stageNumber === 4 ? 286 : 292 + difficulty * 4,
    recommendedJumpVelocity: -625,
  };
}

function generateShipMap(rng, stageNumber) {
  const obstacles = [];
  const pads = [];
  const difficulty = stageNumber - 1;
  let x = 0;
  let center = 268;

  while (x < STAGE_LENGTH) {
    const segW = x < 420 ? 180 : rng.int(180, 260);
    const shift = x < 420 ? 0 : rng.int(-1, 1) * (12 + difficulty * 2);
    center = clamp(center + shift, 175, 340);
    const stageGapBase = stageNumber === 1 ? 238 : stageNumber === 2 ? 230 : stageNumber === 3 ? 222 : 214;
    const gap = clamp(stageGapBase + rng.int(-8, 14), 198, 250);
    const topHeight = clamp(center - gap / 2, 70, 300);
    const bottomStart = clamp(center + gap / 2, 230, WORLD_HEIGHT - 90);

    obstacles.push(obstacleRect('block', x, 0, segW, Math.round(topHeight), { zone: 'top' }));
    obstacles.push(obstacleRect('block', x, Math.round(bottomStart), segW, WORLD_HEIGHT - Math.round(bottomStart), { zone: 'bottom' }));

    if (x > 260 && rng.chance(stageNumber === 1 ? 0.08 : stageNumber === 2 ? 0.13 : stageNumber === 3 ? 0.17 : 0.2)) {
      const spikeW = 30;
      const spikeH = 22;
      const spikeX = x + rng.int(24, Math.max(24, segW - 56));
      if (rng.chance(0.5)) {
        obstacles.push(obstacleRect('spikeDown', spikeX, Math.round(topHeight) - 2, spikeW, spikeH));
      } else {
        obstacles.push(obstacleRect('spikeUp', spikeX, Math.round(bottomStart) - spikeH + 2, spikeW, spikeH));
      }
    }

    if (x > 320 && x < STAGE_LENGTH - 500 && rng.chance(stageNumber === 1 ? 0.04 : stageNumber === 2 ? 0.08 : stageNumber === 3 ? 0.11 : 0.14)) {
      const padType = rng.pick(SHIP_PAD_TYPES);
      const midY = clamp(center - 14, 140, WORLD_HEIGHT - 150);
      pads.push(
        padRect(padType, x + segW * 0.5 - 18, midY, 36, 36, {
          multiplier: padType === 'boost' ? 1.34 : 0.8,
          duration: padType === 'boost' ? 2 : 2.5,
          floating: true,
        }),
      );
    }

    x += segW;
  }

  return {
    type: 'ship',
    groundY: GROUND_Y,
    obstacles,
    pads,
    length: STAGE_LENGTH,
    baseSpeed: 280 + difficulty * 5,
    thrust: 1500,
  };
}

function buildBridgePlatforms(stageNumber, character) {
  if (character !== 'cube' || stageNumber < 3) return { pits: [], platforms: [] };
  // Alternating bridges: only the platforms matching the current world are solid.
  // Stage 4 deliberately uses wider platforms and shorter gaps than stage 3.
  const start = stageNumber === 3 ? 3240 : 3500;
  const width = stageNumber === 3 ? 142 : 166;
  const gap = stageNumber === 3 ? 54 : 34;
  // Start/end platforms sit close to the normal ground for fair entry and exit.
  const heights = stageNumber === 3 ? [392, 346, 372, 342, 390] : [392, 360, 378, 350, 388];
  const platforms = heights.map((y, i) => ({
    x: start + i * (width + gap), y, w: width, h: 18, phase: i % 2,
    label: i % 2 === 0 ? 'REAL' : 'FLIP',
  }));
  const end = platforms[platforms.length - 1].x + platforms[platforms.length - 1].w;
  return { pits: [{ x: start - 36, end: end + 42 }], platforms };
}

function isInsideBridgePit(worldX) {
  return Boolean(app.world?.bridgePits?.some((pit) => worldX >= pit.x && worldX <= pit.end));
}

function groundYAtWorldX(worldX) {
  const base = terrainYAt(app.world?.terrain, worldX);
  // Visual terrain is drawn below the playfield in pits, but it must NOT act as a floor.
  return isInsideBridgePit(worldX) ? WORLD_HEIGHT + 100 : base;
}

function generateStageMap({ stageNumber, character, sessionSeed }) {
  const seed = hashString(`${sessionSeed}-${character}-${stageNumber}`);
  const rng = new SeededRandom(seed);
  const base = character === 'ship' ? generateShipMap(rng, stageNumber) : generateCubeMap(rng, stageNumber);
  const terrain = buildTerrain(stageNumber, character);
  if (character === 'cube' && stageNumber >= 2) {
    // Move existing obstacles with the local ground height so they sit on the terrain.
    for (const item of [...base.obstacles, ...base.pads]) {
      const localGround = terrainYAt(terrain, item.x);
      const shift = localGround - GROUND_Y;
      item.y += shift;
    }
    // Mandatory jump-pad gates: the normal jump cannot clear these high blocks.
    // The pad is placed directly before each gate and activates on contact.
    const gates = stageNumber === 2 ? [1750, 3950, 6100] : stageNumber === 3 ? [1750, 3450, 5150, 6800] : [1600, 3150, 4700, 6250, 7350];
    gates.forEach((gateX, index) => {
      // Keep a clean, readable approach so random patterns cannot obscure the pad.
      base.obstacles = base.obstacles.filter(o => Math.abs(o.x - gateX) > 180 && Math.abs(o.x - (gateX - 100)) > 180);
      base.pads = base.pads.filter(pad => Math.abs(pad.x - gateX) > 180 && Math.abs(pad.x - (gateX - 100)) > 180);
      const ground = terrainYAt(terrain, gateX);
      base.pads.push(padRect('jump', gateX - 100, terrainYAt(terrain, gateX - 100) - 18, 48, 18, { power: 790, mandatory: true, label: `BOOST GATE ${index + 1}` }));
      base.obstacles.push(obstacleRect('block', gateX, ground - 145, 54, 145, { mandatoryGate: true }));
    });
  }

  // Dual-world route: stages 3 and 4 have alternating hazards in two realities.
  // A hazard exists in only one phase, so players must actively switch worlds to pass.
  const phaseObstacles = [];
  if (character === 'cube' && stageNumber >= 3) {
    let phaseIndex = 0;
    for (let gateX = 1180; gateX < STAGE_LENGTH - 420; gateX += (stageNumber === 3 ? 820 : 920)) {
      const phase = phaseIndex % 2;
      const ground = terrainYAt(terrain, gateX);
      phaseObstacles.push(obstacleRect('spikeUp', gateX, ground - 31, 30, 31, { phase, phaseGate: true }));
      if (stageNumber === 3) phaseObstacles.push(obstacleRect('spikeUp', gateX + 28, ground - 31, 30, 31, { phase, phaseGate: true }));
      // A glowing marker before each gate communicates which world contains the hazard.
      phaseObstacles.push(obstacleRect('phaseMarker', gateX - 112, ground - 72, 48, 34, { phase, phaseGate: true }));
      phaseIndex += 1;
    }
  }

  const bridge = buildBridgePlatforms(stageNumber, character);
  // The bridge section replaces the ordinary track: clear all procedural obstacles,
  // pads, and phase gates from the pit and its approach/exit so they cannot overlap.
  if (bridge.pits.length) {
    const clearStart = bridge.pits[0].x - 90;
    const clearEnd = bridge.pits[0].end + 90;
    base.obstacles = base.obstacles.filter((o) => o.x + o.w < clearStart || o.x > clearEnd);
    base.pads = base.pads.filter((p) => p.x + p.w < clearStart || p.x > clearEnd);
    for (let i = phaseObstacles.length - 1; i >= 0; i -= 1) {
      const o = phaseObstacles[i];
      if (o.x + o.w >= clearStart && o.x <= clearEnd) phaseObstacles.splice(i, 1);
    }
  }
  return {
    ...base,
    phaseObstacles,
    bridgePlatforms: bridge.platforms,
    bridgePits: bridge.pits,
    terrain,
    stageNumber,
    character,
    seed,
    theme: buildStageTheme(stageNumber, character),
    stars: createStars(rng, STAGE_LENGTH, buildStageTheme(stageNumber, character)),
  };
}


/* =========================================================
   screens.js  –  화면(UI) 관리
   ========================================================= */
const SCREENS = {
  START: 'start',
  CHARACTER: 'character',
  PLAY: 'play',
  FAIL: 'fail',
  CLEAR: 'clear',
  PAUSE: 'pause',
  SETTINGS: 'settings',
  STAGE_SELECT: 'stageSelect',
};

function screenMarkup({ title, body = '', buttons = '' }) {
  return `
    <section class="screen">
      <h1>${title}</h1>
      ${body}
      <div class="button-row">${buttons}</div>
    </section>
  `;
}

function bindButtons(root, handlers) {
  root.querySelectorAll('[data-action]').forEach((button) => {
    button.addEventListener('click', () => {
      const action = button.dataset.action;
      handlers[action]?.(button.dataset.value || undefined);
    });
  });
}

function createScreenManager({
  root,
  hud,
  progressFill,
  progressLabel,
  stageIndicator,
  characterIndicator,
  onAction,
  renderCharacterPreview,
}) {
  const handlers = {
    startGame: () => onAction('startGame'),
    openCharacterSelect: () => onAction('openCharacterSelect'),
    selectCharacter: (value) => onAction('selectCharacter', value),
    beginRun: () => onAction('beginRun'),
    retryStage: () => onAction('retryStage'),
    backToMenu: () => onAction('backToMenu'),
    nextStage: () => onAction('nextStage'),
    pauseGame: () => onAction('pauseGame'),
    resumeGame: () => onAction('resumeGame'),
    openSettings: () => onAction('openSettings'),
    stageSelect: () => onAction('stageSelect'),
    chooseStage: (value) => onAction('chooseStage', value),
    settingsBack: () => onAction('settingsBack'),
    setSpeed: (value) => onAction('setSpeed', value),
  };

  function showStart() {
    document.getElementById('game-controls')?.classList.remove('visible');
    hud.classList.add('hidden');
    root.innerHTML = screenMarkup({
      title: 'GEOMETRY DASH CLONE',
      body: `
        <p>Retro clone-built arcade action with procedural stages, pixel art, and touch/keyboard controls.</p>
        <p class="tip">Tap / click / <span class="flashy">Space</span> to jump as the cube. Hold to fly as the ship.</p>
      `,
      buttons: `
        <button class="pixel-button" data-action="openCharacterSelect">PLAY</button>
      `,
    });
    bindButtons(root, handlers);
  }

  function showCharacterSelect({ selectedCharacter }) {
    hud.classList.add('hidden');
    root.innerHTML = `
      <section class="screen">
        <h2>CHOOSE YOUR RUNNER</h2>
        <p>Select a style. Each character has four seeded stages and its own feel.</p>
        <div class="card-row">
          <button class="character-card ${selectedCharacter === 'cube' ? 'selected' : ''}" data-action="selectCharacter" data-value="cube">
            <canvas width="180" height="180" data-preview="cube"></canvas>
            <strong>CUBE</strong>
            <p class="tip">Ground runner with timed jumps and jump pads.</p>
          </button>
          <button class="character-card ${selectedCharacter === 'ship' ? 'selected' : ''}" data-action="selectCharacter" data-value="ship">
            <canvas width="180" height="180" data-preview="ship"></canvas>
            <strong>SHIP</strong>
            <p class="tip">Smooth thrust flight through tight pixel tunnels.</p>
          </button>
        </div>
        <div class="button-row">
          <button class="pixel-button alt" data-action="backToMenu">MENU</button>
          <button class="pixel-button" data-action="beginRun">START RUN</button>
        </div>
      </section>
    `;

    root.querySelectorAll('[data-preview]').forEach((canvas) => {
      renderCharacterPreview(canvas, canvas.dataset.preview);
    });

    bindButtons(root, handlers);
  }

  function showFail({ percent }) {
    hud.classList.add('hidden');
    root.innerHTML = screenMarkup({
      title: 'RUN FAILED',
      body: `
        <p>You reached <span class="flashy">${percent}%</span> of the stage.</p>
        <p class="tip">Retry the same seeded map or head back to the menu.</p>
      `,
      buttons: `
        <button class="pixel-button danger" data-action="retryStage">RETRY?</button>
        <button class="pixel-button alt" data-action="backToMenu">MENU</button>
      `,
    });
    bindButtons(root, handlers);
  }

  function showClear({ attempts, timeTaken, stageNumber, isLastStage }) {
    hud.classList.add('hidden');
    root.innerHTML = screenMarkup({
      title: stageNumber >= 4 ? 'RUN COMPLETE!' : 'STAGE CLEAR!',
      body: `
        <div class="mini-stats">
          <div>ATTEMPTS: <span class="flashy">${attempts}</span></div>
          <div>TIME: <span class="flashy">${timeTaken.toFixed(1)}s</span></div>
          <div>STAGE: <span class="flashy">${stageNumber}</span></div>
        </div>
      `,
      buttons: isLastStage
        ? `
            <button class="pixel-button" data-action="stageSelect">SELECT STAGE</button>
            <button class="pixel-button alt" data-action="backToMenu">MENU</button>
            <button class="pixel-button alt" data-action="openCharacterSelect">SWITCH CHARACTER</button>
          `
        : `
            <button class="pixel-button" data-action="nextStage">NEXT STAGE</button>
            <button class="pixel-button alt" data-action="stageSelect">SELECT STAGE</button>
            <button class="pixel-button alt" data-action="backToMenu">MENU</button>
          `,
    });
    bindButtons(root, handlers);
  }

  function showPause() {
    hud.classList.remove('hidden');
    root.innerHTML = screenMarkup({ title: 'PAUSED', body: '<p>게임이 일시정지됐어.</p><p class="tip">계속하기를 누르면 멈춘 지점부터 이어서 플레이해.</p>', buttons: '<button class="pixel-button" data-action="resumeGame">계속하기</button><button class="pixel-button alt" data-action="openSettings">설정</button><button class="pixel-button alt" data-action="stageSelect">스테이지 선택</button><button class="pixel-button danger" data-action="backToMenu">메뉴</button>' });
    bindButtons(root, handlers);
  }

  function showSettings({ speedLevel }) {
    hud.classList.remove('hidden');
    root.innerHTML = screenMarkup({ title: 'SETTINGS', body: `<p>게임은 설정 화면에서 일시정지돼.</p><div class="setting-row"><span>게임 속도</span><button data-action="setSpeed" data-value="${speedLevel === 1 ? 2 : speedLevel === 2 ? 3 : 1}">${speedLevel === 1 ? '느림' : speedLevel === 2 ? '보통' : '빠름'} · 변경</button></div><p class="tip">속도는 게임 진행 속도에 적용돼.</p>`, buttons: '<button class="pixel-button" data-action="settingsBack">돌아가기</button><button class="pixel-button alt" data-action="resumeGame">계속하기</button>' });
    bindButtons(root, handlers);
  }

  function showStageSelect({ currentStage, character }) {
    hud.classList.remove('hidden');
    const descriptions = ['입문 코스 · 평지에서 점프 연습', '언덕 코스 · 경사로를 오르내리고 필수 점프 패드 통과', '두 세계 · X 키로 현실과 반전 세계를 전환', '불안정한 차원 · 더 빠르게 바뀌는 세계별 장애물'];
    const cards = descriptions.map((desc, i) => `<button class="stage-card ${currentStage === i + 1 ? 'selected' : ''}" data-action="chooseStage" data-value="${i+1}"><strong>STAGE ${i+1} ${currentStage === i+1 ? '· 현재' : ''}</strong><span>${desc}</span></button>`).join('');
    root.innerHTML = `<section class="screen"><h2>SELECT STAGE</h2><p>원하는 스테이지를 자유롭게 선택할 수 있어.</p><div class="stage-grid">${cards}</div><div class="button-row"><button class="pixel-button alt" data-action="settingsBack">돌아가기</button><button class="pixel-button" data-action="backToMenu">메뉴</button></div></section>`;
    bindButtons(root, handlers);
  }

  function showPlay() {
    root.innerHTML = '';
    hud.classList.remove('hidden');
  }

  function updateHud({ progress, stage, character }) {
    progressFill.style.width = `${Math.max(0, Math.min(100, progress * 100))}%`;
    progressLabel.textContent = `${Math.round(progress * 100)}%`;
    stageIndicator.textContent = `STAGE ${stage}`;
    characterIndicator.textContent = character.toUpperCase();
  }

  return {
    showStart,
    showCharacterSelect,
    showFail,
    showClear,
    showPlay,
    showPause,
    showSettings,
    showStageSelect,
    updateHud,
  };
}


/* =========================================================
   game.js  –  게임 루프·물리·렌더링·오디오
   ========================================================= */

const canvas = document.getElementById('game-canvas');
const hud = document.getElementById('hud');
const progressFill = document.getElementById('progress-fill');
const progressLabel = document.getElementById('progress-label');
const stageIndicator = document.getElementById('stage-indicator');
const characterIndicator = document.getElementById('character-indicator');
const screenRoot = document.getElementById('screen-root');

const ctx = canvas.getContext('2d');
const DPR = window.devicePixelRatio || 1;


const BUTTON_SOUND = 'sound/geometry-dash-click-sound.mp3';
const DEATH_SOUND = 'sound/geometry-dash-death-sound-effect.mp3';
const MENU_MUSIC = 'sound/geometry-dash-menu-theme_xkGGC9M.mp3';
const STAGE_MUSIC = {
  1: 'sound/stage1_stereo-madness.mp3',
  2: 'sound/stage2_practice-mode-geometry-dash_yxAuTWe.mp3',
  3: 'sound/stage3.mp3',
  4: 'sound/stage4.mp3',
};

const app = {
  screen: SCREENS.START,
  previousOverlay: SCREENS.PAUSE,
  speedLevel: 2,
  sessionSeed: Math.floor(Math.random() * 1_000_000_000),
  selectedCharacter: 'cube',
  currentStage: 1,
  attempts: {
    cube: [0, 0, 0, 0, 0],
    ship: [0, 0, 0, 0, 0],
  },
  maps: {
    cube: new Map(),
    ship: new Map(),
  },
  input: {
    pressed: false,
    justPressed: false,
  },
  playfield: {
    width: 960,
    height: 540,
  },
  world: null,
  player: null,
  cameraX: 0,
  stageStartMs: 0,
  speedEffect: null,
  padTriggers: new Set(),
  worldPhase: 0,
  phaseFlash: 0,
  lastFrameMs: 0,
  audioUnlocked: false,
  audio: {
    menu: null,
    stage: null,
    click: null,
    death: null,
  },
  clearSummary: null,
  failSummary: null,
};

function makeAudio(src, { loop = false, volume = 1 } = {}) {
  const audio = new Audio(src);
  audio.loop = loop;
  audio.volume = volume;
  audio.preload = 'auto';
  return audio;
}

function setupAudio() {
  app.audio.menu = makeAudio(MENU_MUSIC, { loop: true, volume: 0.35 });
  app.audio.click = makeAudio(BUTTON_SOUND, { volume: 0.6 });
  app.audio.death = makeAudio(DEATH_SOUND, { volume: 0.7 });
}

function unlockAudio() {
  if (app.audioUnlocked) return;
  app.audioUnlocked = true;
  if (app.screen !== SCREENS.PLAY) {
    void playMenuMusic();
  }
}

async function playMenuMusic() {
  if (!app.audio.menu) return;
  stopStageMusic();
  app.audio.menu.currentTime = 0;
  try {
    await app.audio.menu.play();
  } catch {
    // Browser may require interaction first.
  }
}

function stopMenuMusic() {
  if (!app.audio.menu) return;
  app.audio.menu.pause();
}

async function playStageMusic(stageNumber) {
  stopMenuMusic();
  stopStageMusic();
  app.audio.stage = makeAudio(STAGE_MUSIC[stageNumber], { loop: true, volume: 0.4 });
  try {
    await app.audio.stage.play();
  } catch {
    // Browser may require interaction first.
  }
}

function stopStageMusic() {
  if (!app.audio.stage) return;
  app.audio.stage.pause();
  app.audio.stage = null;
}

function playSfx(kind) {
  const audio = app.audio[kind];
  if (!audio) return;
  try {
    audio.currentTime = 0;
    void audio.play();
  } catch {
    // Ignore autoplay restrictions.
  }
}

function getStageMap(character, stageNumber) {
  const characterMaps = app.maps[character];
  if (!characterMaps.has(stageNumber)) {
    characterMaps.set(stageNumber, generateStageMap({ stageNumber, character, sessionSeed: app.sessionSeed }));
  }
  return characterMaps.get(stageNumber);
}

function createPlayer(character) {
  return character === 'ship'
    ? {
        character,
        w: 36,
        h: 24,
        screenX: 170,
        y: 260,
        vy: 0,
        rotation: 0,
      }
    : {
        character,
        w: 28,
        h: 28,
        screenX: 170,
        y: GROUND_Y - 28,
        vy: 0,
        grounded: true,
        rotation: 0,
      };
}

function resizeCanvas() {
  if (!canvas || !ctx) return;
  const width = window.innerWidth;
  const height = window.innerHeight;
  canvas.width = Math.floor(width * DPR);
  canvas.height = Math.floor(height * DPR);
  canvas.style.width = `${width}px`;
  canvas.style.height = `${height}px`;
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

  const scale = Math.min(width / 960, height / 540);
  app.playfield.width = Math.floor(960 * scale);
  app.playfield.height = Math.floor(540 * scale);
}

function worldScale() {
  return app.playfield.width / 960;
}

function fieldOffset() {
  return {
    x: (window.innerWidth - app.playfield.width) / 2,
    y: (window.innerHeight - app.playfield.height) / 2,
  };
}

function getPlayerRect() {
  const player = app.player;
  if (!player) return null;
  return {
    x: app.cameraX + player.screenX - player.w / 2,
    y: player.y,
    w: player.w,
    h: player.h,
  };
}

function rectsOverlap(a, b) {
  return a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;
}

function pointInTriangle(px, py, a, b, c) {
  const area = (p1, p2, p3) => (p1.x * (p2.y - p3.y) + p2.x * (p3.y - p1.y) + p3.x * (p1.y - p2.y)) / 2;
  const total = Math.abs(area(a, b, c));
  const part = Math.abs(area({ x: px, y: py }, b, c)) + Math.abs(area(a, { x: px, y: py }, c)) + Math.abs(area(a, b, { x: px, y: py }));
  return Math.abs(total - part) < 0.5;
}

function triangleCollision(rect, obstacle) {
  const { x, y, w, h, type } = obstacle;
  const points =
    type === 'spikeDown'
      ? [
          { x, y },
          { x: x + w / 2, y: y + h },
          { x: x + w, y },
        ]
      : [
          { x, y: y + h },
          { x: x + w / 2, y },
          { x: x + w, y: y + h },
        ];

  const rectPoints = [
    { x: rect.x, y: rect.y },
    { x: rect.x + rect.w, y: rect.y },
    { x: rect.x, y: rect.y + rect.h },
    { x: rect.x + rect.w, y: rect.y + rect.h },
    { x: rect.x + rect.w / 2, y: rect.y + rect.h / 2 },
  ];

  if (rectsOverlap(rect, obstacle) && rectPoints.some((point) => pointInTriangle(point.x, point.y, points[0], points[1], points[2]))) {
    return true;
  }

  return rectsOverlap(rect, obstacle) && points.some((point) => point.x >= rect.x && point.x <= rect.x + rect.w && point.y >= rect.y && point.y <= rect.y + rect.h);
}

function applyPadEffect(pad) {
  if (!pad || app.padTriggers.has(pad.id)) return;
  app.padTriggers.add(pad.id);
  playSfx('click');

  if ((pad.type === 'jump' || pad.type === 'orb') && app.player.character === 'cube') {
    app.player.vy = -pad.power;
    app.player.grounded = false;
  }

  if (pad.type === 'boost' || pad.type === 'slow') {
    app.speedEffect = {
      multiplier: pad.multiplier,
      timer: pad.duration,
    };
  }
}

function collidePlayer() {
  const rect = getPlayerRect();
  if (!rect || !app.world) return false;

  for (const obstacle of app.world.obstacles) {
    if (obstacle.type === 'block' && rectsOverlap(rect, obstacle)) {
      return true;
    }
    if ((obstacle.type === 'spikeUp' || obstacle.type === 'spikeDown') && triangleCollision(rect, obstacle)) {
      return true;
    }
  }

  for (const obstacle of (app.world.phaseObstacles || [])) {
    if (obstacle.phase !== app.worldPhase || obstacle.type === 'phaseMarker') continue;
    if ((obstacle.type === 'spikeUp' || obstacle.type === 'spikeDown') && triangleCollision(rect, obstacle)) return true;
    if (obstacle.type === 'block' && rectsOverlap(rect, obstacle)) return true;
  }

  for (const pad of app.world.pads) {
    if (!rectsOverlap(rect, pad)) continue;
    if (pad.type === 'orb') {
      if (app.input.justPressed && !app.padTriggers.has(pad.id)) applyPadEffect(pad);
    } else if (pad.type === 'jump' || pad.type === 'boost' || pad.type === 'slow') {
      applyPadEffect(pad);
    }
  }

  return false;
}

function resetStage(stageNumber = app.currentStage) {
  app.currentStage = stageNumber;
  app.world = getStageMap(app.selectedCharacter, app.currentStage);
  app.player = createPlayer(app.selectedCharacter);
  app.cameraX = 0;
  app.speedEffect = null;
  app.padTriggers = new Set();
  app.worldPhase = 0;
  app.phaseFlash = 0;
  document.getElementById('world-switch-button')?.classList.toggle('enabled', app.selectedCharacter === 'cube' && stageNumber >= 3);
  document.getElementById('world-switch-button')?.classList.remove('phase-b');
  const worldButton = document.getElementById('world-switch-button');
  if (worldButton) worldButton.textContent = '⇄ 세계 전환 [X]';
  app.stageStartMs = performance.now();
  app.attempts[app.selectedCharacter][app.currentStage] += 1;
  app.screen = SCREENS.PLAY;
  screenManager.showPlay();
  document.getElementById('game-controls')?.classList.add('visible');
  screenManager.updateHud({ progress: 0, stage: app.currentStage, character: app.selectedCharacter });
  void playStageMusic(app.currentStage);
}

function failStage() {
  document.getElementById('game-controls')?.classList.remove('visible');
  stopStageMusic();
  playSfx('death');
  app.screen = SCREENS.FAIL;
  const progress = clamp((app.cameraX + app.player.screenX) / app.world.length, 0, 1);
  app.failSummary = { percent: Math.round(progress * 100) };
  screenManager.showFail(app.failSummary);
}

function clearStage() {
  document.getElementById('game-controls')?.classList.remove('visible');
  stopStageMusic();
  app.screen = SCREENS.CLEAR;
  const timeTaken = (performance.now() - app.stageStartMs) / 1000;
  app.clearSummary = {
    attempts: app.attempts[app.selectedCharacter][app.currentStage],
    timeTaken,
    stageNumber: app.currentStage,
    isLastStage: app.currentStage >= 4,
  };
  screenManager.showClear(app.clearSummary);
}

function currentSpeed() {
  if (!app.world) return 0;
  const effect = app.speedEffect?.multiplier || 1;
  const settingMultiplier = app.speedLevel === 1 ? 0.78 : app.speedLevel === 3 ? 1.12 : 1;
  return app.world.baseSpeed * effect * settingMultiplier;
}

function updateCube(dt) {
  const player = app.player;
  const jumpVelocity = app.world.recommendedJumpVelocity;

  if (app.input.justPressed && player.grounded) {
    player.vy = jumpVelocity;
    player.grounded = false;
    playSfx('click');
  }

  player.vy += 1800 * dt;
  player.y += player.vy * dt;
  player.rotation += dt * 7;

  const playerWorldX = app.cameraX + player.screenX;
  const inBridgePit = isInsideBridgePit(playerWorldX);
  const groundY = groundYAtWorldX(playerWorldX);
  let landedOnBridge = false;
  const previousBottom = player.y + player.h - player.vy * dt;
  for (const platform of (app.world.bridgePlatforms || [])) {
    const overlapsX = playerWorldX + player.w * 0.35 >= platform.x && playerWorldX - player.w * 0.35 <= platform.x + platform.w;
    const wasAbove = previousBottom <= platform.y + 10;
    if (platform.phase === app.worldPhase && overlapsX && player.vy >= 0 && wasAbove && player.y + player.h >= platform.y) {
      player.y = platform.y - player.h;
      player.vy = 0;
      player.grounded = true;
      player.rotation = 0;
      landedOnBridge = true;
      break;
    }
  }
  if (!landedOnBridge && !inBridgePit && player.vy >= 0 && player.y + player.h >= groundY) {
    player.y = groundY - player.h;
    player.vy = 0;
    player.grounded = true;
    player.rotation = 0;
  } else if (!landedOnBridge && player.grounded) {
    // If the active bridge disappeared or the player ran off its edge, gravity takes over.
    const standingOnBridge = (app.world.bridgePlatforms || []).some((platform) =>
      platform.phase === app.worldPhase && playerWorldX + player.w * 0.35 >= platform.x && playerWorldX - player.w * 0.35 <= platform.x + platform.w && Math.abs(player.y + player.h - platform.y) < 3
    );
    if (groundY < WORLD_HEIGHT + 50) player.y = groundY - player.h;
    else if (!standingOnBridge) player.grounded = false;
  }

  // A missed bridge must cause a real fall/death instead of landing on an invisible pit floor.
  if ((inBridgePit && player.y + player.h > WORLD_HEIGHT - 8) || player.y > WORLD_HEIGHT + 120 || player.y < -160) {
    failStage();
    return;
  }
}

function updateShip(dt) {
  const player = app.player;
  if (app.input.pressed) {
    player.vy -= app.world.thrust * dt;
  }
  player.vy += 980 * dt;
  player.vy = clamp(player.vy, -520, 520);
  player.y += player.vy * dt;
  player.rotation = clamp(player.vy / 420, -0.8, 0.8);

  if (player.y <= 0 || player.y + player.h >= WORLD_HEIGHT) {
    failStage();
  }
}

function switchWorldPhase() {
  if (app.screen !== SCREENS.PLAY || !app.world || app.selectedCharacter !== 'cube' || app.currentStage < 3) return;
  app.worldPhase = app.worldPhase === 0 ? 1 : 0;
  app.phaseFlash = 0.24;
  const button = document.getElementById('world-switch-button');
  button?.classList.toggle('phase-b', app.worldPhase === 1);
  if (button) button.textContent = app.worldPhase === 0 ? '⇄ 현실 세계 [X]' : '⇄ 반전 세계 [X]';
  playSfx('click');
}

function updateGame(dt) {
  if (app.screen !== SCREENS.PLAY || !app.world || !app.player) {
    app.input.justPressed = false;
    return;
  }

  if (app.phaseFlash > 0) app.phaseFlash = Math.max(0, app.phaseFlash - dt);
  if (app.speedEffect) {
    app.speedEffect.timer -= dt;
    if (app.speedEffect.timer <= 0) {
      app.speedEffect = null;
    }
  }

  app.cameraX += currentSpeed() * dt;

  if (app.player.character === 'ship') {
    updateShip(dt);
  } else {
    updateCube(dt);
  }

  if (app.screen === SCREENS.PLAY && collidePlayer()) {
    failStage();
  }

  const progress = clamp((app.cameraX + app.player.screenX) / app.world.length, 0, 1);
  screenManager.updateHud({ progress, stage: app.currentStage, character: app.selectedCharacter });

  if (progress >= 0.995 && app.screen === SCREENS.PLAY) {
    clearStage();
  }

  app.input.justPressed = false;
}

function drawPixelRect(drawCtx, x, y, w, h, color, pixel = 6, accent) {
  drawCtx.fillStyle = color;
  drawCtx.fillRect(Math.round(x), Math.round(y), Math.round(w), Math.round(h));
  if (accent) {
    drawCtx.fillStyle = accent;
    for (let yy = 0; yy < h; yy += pixel * 2) {
      for (let xx = 0; xx < w; xx += pixel * 2) {
        drawCtx.fillRect(Math.round(x + xx), Math.round(y + yy), Math.min(pixel, w - xx), Math.min(pixel, h - yy));
      }
    }
  }
}

function drawGround(drawCtx, theme) {
  if (app.world?.character === 'ship') {
    drawCtx.fillStyle = 'rgba(255,255,255,0.06)';
    drawCtx.fillRect(0, 0, 960, 8);
    drawCtx.fillRect(0, WORLD_HEIGHT - 8, 960, 8);
    return;
  }
  // Fill a polygon that follows the map's elevation profile instead of a flat floor.
  const terrain = app.world?.terrain || [{ x: 0, y: GROUND_Y }, { x: STAGE_LENGTH, y: GROUND_Y }];
  drawCtx.beginPath();
  drawCtx.moveTo(0, WORLD_HEIGHT);
  for (let sx = 0; sx <= 960; sx += 12) {
    const groundY = groundYAtWorldX(app.cameraX + sx);
    drawCtx.lineTo(sx, groundY);
  }
  drawCtx.lineTo(960, WORLD_HEIGHT);
  drawCtx.closePath();
  drawCtx.fillStyle = theme.ground;
  drawCtx.fill();
  drawCtx.save();
  drawCtx.beginPath();
  for (let sx = 0; sx <= 960; sx += 12) {
    const groundY = groundYAtWorldX(app.cameraX + sx);
    if (sx === 0) drawCtx.moveTo(sx, groundY); else drawCtx.lineTo(sx, groundY);
  }
  drawCtx.strokeStyle = theme.glow;
  drawCtx.lineWidth = 5;
  drawCtx.stroke();
  drawCtx.restore();
  drawCtx.fillStyle = theme.ground2;
  for (let sx = 0; sx < 960; sx += TILE) {
    const groundY = groundYAtWorldX(app.cameraX + sx + 4);
    drawCtx.fillRect(sx, groundY + 15, TILE / 2, 4);
  }
}

function drawParallax(drawCtx, theme) {
  const gradient = drawCtx.createLinearGradient(0, 0, 0, WORLD_HEIGHT);
  gradient.addColorStop(0, theme.skyTop);
  gradient.addColorStop(1, theme.skyBottom);
  drawCtx.fillStyle = gradient;
  drawCtx.fillRect(0, 0, 960, WORLD_HEIGHT);

  app.world?.stars.forEach((star) => {
    const px = ((star.x - app.cameraX * star.speedFactor) % 960 + 960) % 960;
    drawCtx.fillStyle = star.color;
    drawCtx.globalAlpha = 0.35 + star.layer * 0.2;
    drawCtx.fillRect(Math.round(px), Math.round(star.y), star.size, star.size);
    drawCtx.globalAlpha = 1;
  });

  drawCtx.fillStyle = 'rgba(255,255,255,0.05)';
  for (let i = 0; i < 7; i += 1) {
    const width = 140 + i * 24;
    const height = 40 + (i % 3) * 30;
    const x = ((i * 170 - app.cameraX * (0.12 + i * 0.02)) % 1180 + 1180) % 1180 - 110;
    const y = 120 + i * 42;
    drawCtx.fillRect(x, y, width, height);
  }
}

function drawArrow(drawCtx, x, y, color, direction = 'up') {
  drawCtx.fillStyle = color;
  if (direction === 'up') {
    drawCtx.fillRect(x + 10, y + 8, 8, 16);
    drawCtx.beginPath();
    drawCtx.moveTo(x + 14, y);
    drawCtx.lineTo(x + 28, y + 12);
    drawCtx.lineTo(x, y + 12);
    drawCtx.closePath();
    drawCtx.fill();
  } else if (direction === 'right') {
    drawCtx.fillRect(x, y + 9, 20, 8);
    drawCtx.beginPath();
    drawCtx.moveTo(x + 30, y + 13);
    drawCtx.lineTo(x + 18, y + 24);
    drawCtx.lineTo(x + 18, y + 2);
    drawCtx.closePath();
    drawCtx.fill();
  } else if (direction === 'left') {
    drawCtx.fillRect(x + 12, y + 9, 20, 8);
    drawCtx.beginPath();
    drawCtx.moveTo(x, y + 13);
    drawCtx.lineTo(x + 12, y + 24);
    drawCtx.lineTo(x + 12, y + 2);
    drawCtx.closePath();
    drawCtx.fill();
  }
}

function drawPads(drawCtx) {
  if (!app.world) return;
  app.world.pads.forEach((pad) => {
    const x = pad.x - app.cameraX;
    if (x < -80 || x > 1040) return;

    if (pad.type === 'jump') {
      drawPixelRect(drawCtx, x, pad.y, pad.w, pad.h, '#6b69ff', 4, '#a6d7ff');
      drawArrow(drawCtx, x + 2, pad.y - 14, '#f5fbff', 'up');
    }

    if (pad.type === 'boost') {
      drawPixelRect(drawCtx, x, pad.y, pad.w, pad.h, '#53d1ff', 4, '#d6ffff');
      drawArrow(drawCtx, x + 2, pad.y + 2, '#10304f', 'right');
      drawArrow(drawCtx, x + 12, pad.y + 2, '#10304f', 'right');
    }

    if (pad.type === 'slow') {
      drawPixelRect(drawCtx, x, pad.y, pad.w, pad.h, '#ffd35b', 4, '#fff2a6');
      drawArrow(drawCtx, x + 4, pad.y + 2, '#654d00', 'left');
    }

    if (pad.type === 'orb') {
      const pulse = 1 + Math.sin(performance.now() / 120) * 0.08;
      drawCtx.save();
      drawCtx.translate(x + pad.w / 2, pad.y + pad.h / 2);
      drawCtx.scale(pulse, pulse);
      drawCtx.strokeStyle = '#ffe95c';
      drawCtx.lineWidth = 5;
      drawCtx.beginPath(); drawCtx.arc(0, 0, 13, 0, Math.PI * 2); drawCtx.stroke();
      drawCtx.fillStyle = 'rgba(255,233,92,0.22)';
      drawCtx.beginPath(); drawCtx.arc(0, 0, 9, 0, Math.PI * 2); drawCtx.fill();
      drawCtx.fillStyle = '#ffffff';
      drawCtx.fillRect(-3, -3, 6, 6);
      drawCtx.restore();
    }
  });
}

function drawBridgePlatforms(drawCtx) {
  if (!app.world?.bridgePlatforms?.length) return;
  for (const platform of app.world.bridgePlatforms) {
    const x = platform.x - app.cameraX;
    if (x + platform.w < -40 || x > 1000) continue;
    const active = platform.phase === app.worldPhase;
    const color = platform.phase === 0 ? '#62f7ff' : '#ff78e7';
    drawCtx.save();
    drawCtx.globalAlpha = active ? 1 : 0.22;
    drawCtx.fillStyle = color;
    drawCtx.fillRect(x, platform.y, platform.w, platform.h);
    drawCtx.fillStyle = '#ffffff';
    drawCtx.fillRect(x + 8, platform.y + 3, platform.w - 16, 3);
    drawCtx.strokeStyle = color;
    drawCtx.lineWidth = 2;
    drawCtx.strokeRect(x, platform.y, platform.w, platform.h);
    drawCtx.font = 'bold 11px Courier New';
    drawCtx.textAlign = 'center';
    drawCtx.fillStyle = active ? '#10172b' : color;
    drawCtx.fillText(platform.label, x + platform.w / 2, platform.y - 7);
    drawCtx.restore();
  }
}

function drawObstacles(drawCtx) {
  if (!app.world) return;
  app.world.obstacles.forEach((obstacle) => {
    const x = obstacle.x - app.cameraX;
    if (x + obstacle.w < -60 || x > 1020) return;
    if (obstacle.type === 'block') {
      drawPixelRect(drawCtx, x, obstacle.y, obstacle.w, obstacle.h, '#355c8f', 6, '#6fd5ff');
      drawCtx.fillStyle = 'rgba(0,0,0,0.18)';
      drawCtx.fillRect(x + obstacle.w - 8, obstacle.y, 8, obstacle.h);
    } else {
      drawCtx.fillStyle = obstacle.type === 'spikeDown' ? '#ff7a9f' : '#ff9f5d';
      drawCtx.beginPath();
      if (obstacle.type === 'spikeDown') {
        drawCtx.moveTo(x, obstacle.y);
        drawCtx.lineTo(x + obstacle.w / 2, obstacle.y + obstacle.h);
        drawCtx.lineTo(x + obstacle.w, obstacle.y);
      } else {
        drawCtx.moveTo(x, obstacle.y + obstacle.h);
        drawCtx.lineTo(x + obstacle.w / 2, obstacle.y);
        drawCtx.lineTo(x + obstacle.w, obstacle.y + obstacle.h);
      }
      drawCtx.closePath();
      drawCtx.fill();
      drawCtx.fillStyle = 'rgba(255,255,255,0.25)';
      drawCtx.fillRect(x + obstacle.w / 2 - 3, obstacle.type === 'spikeDown' ? obstacle.y + obstacle.h / 2 : obstacle.y + obstacle.h / 2, 6, 10);
    }
  });
}

function drawPhaseObstacles(drawCtx) {
  if (!app.world?.phaseObstacles?.length) return;
  for (const obstacle of app.world.phaseObstacles) {
    const x = obstacle.x - app.cameraX;
    if (x + obstacle.w < -60 || x > 1020) continue;
    const active = obstacle.phase === app.worldPhase;
    drawCtx.save();
    drawCtx.globalAlpha = active ? 1 : 0.13;
    if (obstacle.type === 'phaseMarker') {
      drawCtx.fillStyle = obstacle.phase === 0 ? '#62f7ff' : '#ff78e7';
      drawCtx.fillRect(x, obstacle.y, obstacle.w, obstacle.h);
      drawCtx.strokeStyle = '#ffffff'; drawCtx.lineWidth = 2;
      drawCtx.strokeRect(x + 4, obstacle.y + 4, obstacle.w - 8, obstacle.h - 8);
      drawCtx.fillStyle = '#10172b'; drawCtx.font = 'bold 12px Courier New';
      drawCtx.fillText(obstacle.phase === 0 ? 'REAL' : 'FLIP', x + 5, obstacle.y + 21);
    } else {
      drawCtx.fillStyle = obstacle.phase === 0 ? '#62f7ff' : '#ff78e7';
      drawCtx.beginPath();
      drawCtx.moveTo(x, obstacle.y + obstacle.h);
      drawCtx.lineTo(x + obstacle.w / 2, obstacle.y);
      drawCtx.lineTo(x + obstacle.w, obstacle.y + obstacle.h);
      drawCtx.closePath(); drawCtx.fill();
      drawCtx.strokeStyle = '#ffffff'; drawCtx.lineWidth = 1.5; drawCtx.stroke();
    }
    drawCtx.restore();
  }
}

function drawCube(drawCtx, player) {
  const px = player.screenX - player.w / 2;
  drawCtx.save();
  drawCtx.translate(px + player.w / 2, player.y + player.h / 2);
  drawCtx.rotate(player.rotation);
  drawPixelRect(drawCtx, -player.w / 2, -player.h / 2, player.w, player.h, '#53d1ff', 6, '#bdf9ff');
  drawCtx.fillStyle = '#17365f';
  drawCtx.fillRect(-8, -6, 4, 4);
  drawCtx.fillRect(4, -6, 4, 4);
  drawCtx.fillRect(-8, 6, 16, 4);
  drawCtx.restore();
}

function drawShip(drawCtx, player) {
  const px = player.screenX - player.w / 2;
  const py = player.y;
  drawCtx.save();
  drawCtx.translate(px + player.w / 2, py + player.h / 2);
  drawCtx.rotate(player.rotation);
  drawCtx.fillStyle = '#fefefe';
  drawCtx.fillRect(-12, -8, 16, 16);
  drawCtx.fillStyle = '#53d1ff';
  drawCtx.fillRect(-16, -4, 8, 8);
  drawCtx.fillStyle = '#ff7a9f';
  drawCtx.beginPath();
  drawCtx.moveTo(4, -10);
  drawCtx.lineTo(18, 0);
  drawCtx.lineTo(4, 10);
  drawCtx.closePath();
  drawCtx.fill();
  drawCtx.fillStyle = '#ffda67';
  drawCtx.fillRect(-22, -4, 6, 8);
  drawCtx.fillStyle = 'rgba(255, 209, 111, 0.45)';
  drawCtx.fillRect(-28, -2, 8, 4);
  drawCtx.restore();
}

function drawStageMeta(drawCtx) {
  if (!app.world) return;
  drawCtx.fillStyle = 'rgba(255,255,255,0.15)';
  drawCtx.fillRect(0, 0, 960, 1);
  drawCtx.fillStyle = app.world.theme.glow;
  drawCtx.font = '16px Courier New';
  drawCtx.fillText(`SEED ${app.world.seed}`, 16, WORLD_HEIGHT - 18);
}

function drawDimensionEffect(drawCtx, stageNumber, progress) {
  // Stage 3: the flat platform appears to open into a 3D neon tunnel.
  if (stageNumber === 3) {
    const pulse = 0.5 + Math.sin(performance.now() / 420) * 0.16;
    drawCtx.save();
    drawCtx.globalAlpha = pulse;
    drawCtx.strokeStyle = '#7af7ff';
    drawCtx.lineWidth = 1.5;
    drawCtx.beginPath();
    const vanX = 480, vanY = 230;
    for (let x = -240; x <= 1200; x += 80) {
      drawCtx.moveTo(vanX, vanY);
      drawCtx.lineTo(x, 540);
      drawCtx.moveTo(vanX, vanY);
      drawCtx.lineTo(x, 0);
    }
    for (let i = 1; i <= 8; i++) {
      const t = ((i / 8 + progress * 1.8) % 1);
      const y = vanY + (t * t) * 370;
      const half = 22 + t * 570;
      drawCtx.moveTo(vanX - half, y);
      drawCtx.lineTo(vanX + half, y);
    }
    drawCtx.stroke();
    drawCtx.fillStyle = 'rgba(70, 30, 255, 0.08)';
    drawCtx.fillRect(0, 0, 960, 540);
    drawCtx.restore();
    if (progress > 0.34 && progress < 0.38) {
      drawCtx.fillStyle = '#ffffff';
      drawCtx.font = 'bold 24px Courier New';
      drawCtx.textAlign = 'center';
      drawCtx.fillText('ENTERING 3D SPACE', 480, 90);
      drawCtx.textAlign = 'left';
    }
  }

  // Stage 4: unstable dimension — brief scanline/glitch flashes over the 3D tunnel.
  if (stageNumber === 4) {
    const now = performance.now();
    const glitchOn = Math.sin(now / 170) > 0.88 || (progress > 0.48 && progress < 0.51);
    drawCtx.save();
    drawCtx.globalAlpha = 0.16;
    drawCtx.strokeStyle = '#ff4fca';
    drawCtx.lineWidth = 1;
    for (let y = 12; y < 540; y += 28) {
      drawCtx.beginPath(); drawCtx.moveTo(0, y); drawCtx.lineTo(960, y); drawCtx.stroke();
    }
    if (glitchOn) {
      drawCtx.globalAlpha = 0.22;
      drawCtx.fillStyle = '#ff2e78';
      drawCtx.fillRect(0, 90 + (Math.floor(now / 70) % 7) * 42, 960, 9);
      drawCtx.fillStyle = '#32f6ff';
      drawCtx.fillRect(0, 260 + (Math.floor(now / 90) % 5) * 31, 960, 5);
    }
    drawCtx.restore();
  }
}

function render() {
  if (!ctx || !canvas) return;
  ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

  const scale = worldScale();
  const offset = fieldOffset();

  ctx.save();
  ctx.translate(offset.x, offset.y);
  ctx.scale(scale, scale);

  const theme = app.world?.theme || {
    skyTop: '#1d2047',
    skyBottom: '#090c1c',
    glow: '#53d1ff',
    glow2: '#f3ff72',
    ground: '#183352',
    ground2: '#0e213a',
  };

  drawParallax(ctx, theme);
  if (app.world && app.currentStage >= 3 && app.selectedCharacter === 'cube') {
    ctx.save();
    ctx.fillStyle = app.worldPhase === 0 ? 'rgba(25,230,255,0.055)' : 'rgba(255,45,210,0.09)';
    ctx.fillRect(0, 0, 960, WORLD_HEIGHT);
    ctx.restore();
  }
  drawDimensionEffect(ctx, app.currentStage, app.world ? (app.cameraX + (app.player?.screenX || 0)) / app.world.length : 0);
  drawGround(ctx, theme);
  drawBridgePlatforms(ctx);
  drawPads(ctx);
  drawObstacles(ctx);
  drawPhaseObstacles(ctx);
  if (app.phaseFlash > 0) {
    ctx.save(); ctx.globalAlpha = app.phaseFlash / 0.24 * 0.28;
    ctx.fillStyle = app.worldPhase === 0 ? '#62f7ff' : '#ff78e7'; ctx.fillRect(0, 0, 960, WORLD_HEIGHT); ctx.restore();
  }

  if (app.player) {
    if (app.player.character === 'ship') {
      drawShip(ctx, app.player);
    } else {
      drawCube(ctx, app.player);
    }
  }

  if (app.screen === SCREENS.PLAY && app.selectedCharacter === 'cube' && app.currentStage >= 2) {
    ctx.save();
    ctx.fillStyle = 'rgba(255,233,92,0.92)';
    ctx.font = 'bold 14px Courier New';
    ctx.textAlign = 'right';
    ctx.fillText(app.currentStage >= 3 ? 'X/세계 전환: 청록·분홍 발판을 번갈아 켜서 다리를 건너!' : '지형이 오르내려! 보라색 패드는 필수 점프 구간에서 자동 발동해!', 944, 510);
    ctx.textAlign = 'left';
    ctx.restore();
  }
  drawStageMeta(ctx);
  ctx.restore();
}

function renderCharacterPreview(canvasEl, character) {
  const previewCtx = canvasEl.getContext('2d');
  previewCtx.setTransform(1, 0, 0, 1, 0, 0);
  previewCtx.clearRect(0, 0, canvasEl.width, canvasEl.height);
  const previewScale = canvasEl.width / 180;
  previewCtx.scale(previewScale, previewScale);
  previewCtx.fillStyle = '#10172b';
  previewCtx.fillRect(0, 0, 180, 180);
  previewCtx.fillStyle = '#203257';
  previewCtx.fillRect(0, 130, 180, 50);
  previewCtx.fillStyle = '#53d1ff';
  for (let i = 0; i < 6; i += 1) {
    previewCtx.fillRect(18 + i * 26, 26 + (i % 2) * 12, 4, 4);
  }

  if (character === 'ship') {
    previewCtx.translate(85, 84);
    previewCtx.rotate(-0.18);
    previewCtx.fillStyle = '#ffffff';
    previewCtx.fillRect(-18, -12, 24, 24);
    previewCtx.fillStyle = '#53d1ff';
    previewCtx.fillRect(-28, -6, 10, 12);
    previewCtx.fillStyle = '#ff7a9f';
    previewCtx.beginPath();
    previewCtx.moveTo(8, -16);
    previewCtx.lineTo(34, 0);
    previewCtx.lineTo(8, 16);
    previewCtx.closePath();
    previewCtx.fill();
    previewCtx.fillStyle = '#ffda67';
    previewCtx.fillRect(-38, -6, 10, 12);
  } else {
    previewCtx.translate(90, 92);
    drawPixelRect(previewCtx, -28, -28, 56, 56, '#53d1ff', 8, '#bdf9ff');
    previewCtx.fillStyle = '#17365f';
    previewCtx.fillRect(-15, -12, 8, 8);
    previewCtx.fillRect(7, -12, 8, 8);
    previewCtx.fillRect(-15, 10, 30, 6);
  }
}

function animate(timestamp) {
  const dt = clamp((timestamp - (app.lastFrameMs || timestamp)) / 1000, 0, 0.033);
  app.lastFrameMs = timestamp;
  updateGame(dt);
  render();
  requestAnimationFrame(animate);
}

function onPressStart(event) {
  if (event.target instanceof Element && event.target.closest('.pixel-button, .character-card')) {
    unlockAudio();
  }
  if (app.screen === SCREENS.PLAY) {
    if (event.target instanceof Element && event.target.closest('#game-controls button')) return;
    unlockAudio();
    app.input.pressed = true;
    app.input.justPressed = true;
    event.preventDefault();
  }
}

function onPressEnd(event) {
  if (app.screen === SCREENS.PLAY) {
    app.input.pressed = false;
    event.preventDefault();
  }
}

function handleScreenAction(action, value) {
  unlockAudio();
  playSfx('click');

  if (action === 'openCharacterSelect') {
    app.screen = SCREENS.CHARACTER;
    screenManager.showCharacterSelect({ selectedCharacter: app.selectedCharacter });
    void playMenuMusic();
  }

  if (action === 'pauseGame') {
    if (app.screen === SCREENS.PLAY) {
      app.previousOverlay = SCREENS.PAUSE;
      app.screen = SCREENS.PAUSE;
      app.input.pressed = false;
      stopStageMusic();
      screenManager.showPause();
    }
    return;
  }
  if (action === 'resumeGame') {
    if ([SCREENS.PAUSE, SCREENS.SETTINGS, SCREENS.STAGE_SELECT].includes(app.screen)) {
      app.screen = SCREENS.PLAY;
      screenManager.showPlay();
      document.getElementById('game-controls')?.classList.add('visible');
      void playStageMusic(app.currentStage);
    }
    return;
  }
  if (action === 'openSettings') {
    app.previousOverlay = app.screen === SCREENS.PLAY ? SCREENS.PLAY : SCREENS.PAUSE;
    if (app.screen === SCREENS.PLAY) stopStageMusic();
    app.screen = SCREENS.SETTINGS;
    screenManager.showSettings({ speedLevel: app.speedLevel });
    return;
  }
  if (action === 'settingsBack') {
    if (app.previousOverlay === SCREENS.PLAY) {
      app.screen = SCREENS.PLAY;
      screenManager.showPlay();
      document.getElementById('game-controls')?.classList.add('visible');
      void playStageMusic(app.currentStage);
    } else if (app.previousOverlay === SCREENS.START) {
      app.screen = SCREENS.START;
      screenManager.showStart();
    } else {
      app.screen = SCREENS.PAUSE;
      screenManager.showPause();
    }
    return;
  }
  if (action === 'setSpeed' && value) {
    app.speedLevel = Number(value);
    screenManager.showSettings({ speedLevel: app.speedLevel });
    return;
  }
  if (action === 'stageSelect') {
    app.previousOverlay = app.screen === SCREENS.PLAY ? SCREENS.PLAY : app.screen === SCREENS.PAUSE ? SCREENS.PAUSE : SCREENS.START;
    app.input.pressed = false;
    stopStageMusic();
    app.screen = SCREENS.STAGE_SELECT;
    screenManager.showStageSelect({ currentStage: app.currentStage, character: app.selectedCharacter });
    return;
  }
  if (action === 'chooseStage' && value) {
    resetStage(Number(value));
    return;
  }
  if (action === 'backToMenu') {
    document.getElementById('game-controls')?.classList.remove('visible');
    app.screen = SCREENS.START;
    stopStageMusic();
    screenManager.showStart();
    void playMenuMusic();
  }

  if (action === 'selectCharacter' && value) {
    app.selectedCharacter = value;
    app.currentStage = 1;
    screenManager.showCharacterSelect({ selectedCharacter: app.selectedCharacter });
  }

  if (action === 'beginRun' || action === 'startGame') {
    app.currentStage = 1;
    resetStage(1);
  }

  if (action === 'retryStage') {
    resetStage(app.currentStage);
  }

  if (action === 'nextStage') {
    resetStage(app.currentStage + 1);
  }
}

const screenManager =
  createScreenManager({
        root: screenRoot,
        hud,
        progressFill,
        progressLabel,
        stageIndicator,
        characterIndicator,
        onAction: handleScreenAction,
        renderCharacterPreview,
      });

function init() {
  if (!canvas || !ctx || !screenManager) return;
  setupAudio();
  document.getElementById('pause-button')?.addEventListener('click', () => handleScreenAction('pauseGame'));
  document.getElementById('world-switch-button')?.addEventListener('click', switchWorldPhase);
  resizeCanvas();
  app.world = getStageMap(app.selectedCharacter, app.currentStage);
  app.player = createPlayer(app.selectedCharacter);
  screenManager.showStart();
  void playMenuMusic();
  requestAnimationFrame(animate);
}

// 초기화
  window.addEventListener('resize', resizeCanvas);
  window.addEventListener('keydown', (event) => {
    if (event.code === 'Escape' || event.code === 'KeyP') {
      if (app.screen === SCREENS.PLAY) handleScreenAction('pauseGame');
      else if ([SCREENS.PAUSE, SCREENS.SETTINGS, SCREENS.STAGE_SELECT].includes(app.screen)) handleScreenAction('resumeGame');
      event.preventDefault();
      return;
    }
    if (event.code === 'KeyX' || event.code === 'ShiftLeft' || event.code === 'ShiftRight') {
      if (!event.repeat) switchWorldPhase();
      event.preventDefault();
      return;
    }
    if (event.code === 'Space') {
      if (!event.repeat) {
        onPressStart(event);
      }
      event.preventDefault();
    }
  });
  window.addEventListener('keyup', (event) => {
    if (event.code === 'Space') {
      onPressEnd(event);
    }
  });
  window.addEventListener('pointerdown', onPressStart, { passive: false });
  window.addEventListener('pointerup', onPressEnd, { passive: false });
  window.addEventListener('pointercancel', onPressEnd, { passive: false });
  window.addEventListener('blur', () => {
    app.input.pressed = false;
  });
  window.addEventListener('DOMContentLoaded', init);
  </script>
</body>
</html>
